{
  "name": "plugin-skeleton",
  "version": "1.0.0",
  "description": "uTools / ZTools 双平台插件脚手架",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run type-check && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --build && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "create": "node scripts/create-plugin.mjs",
    "ztools:publish": "ztools publish"
  },
  "dependencies": {
    "naive-ui": "^2.45.3",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@ztools-center/plugin-cli": "^1.3.0",
    "@ztools-center/ztools-api-types": "^1.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.0",
    "prettier": "^3.9.8",
    "typescript": "~5.9.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  }
}
